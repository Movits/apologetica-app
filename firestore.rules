// Regras de segurança do Firestore para o APPologética.
// Cole estas regras no console do Firebase em Firestore Database -> Rules.
//
// Cada usuário só pode ler e escrever os documentos abaixo do próprio UID.
// Ninguém anônimo consegue ler ou escrever nada.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
