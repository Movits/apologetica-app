{
  "expo": {
    "name": "APPologética",
    "slug": "apologetica-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "appologetica",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appologetica.app"
    },
    "android": {
      "package": "com.appologetica.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a3a5c"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "appologetica"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a3a5c",
          "dark": {
            "backgroundColor": "#142844"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c9a84c"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf11bc18-bc5d-4d38-ab78-fa688d1c4ca3"
      }
    }
  }
}
